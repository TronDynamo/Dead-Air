<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>DEAD AIR — A cooperative signal thriller</title>
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<style>
:root{--bg:#070b12;--panel:#101925;--line:#233448;--cyan:#63f3e4;--amber:#ffc66d;--red:#ff647c;--muted:#8ba0b6;--white:#edf6ff}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 50% -15%,#193044 0%,#090f18 48%,#05080d 100%);color:var(--white);font-family:Inter,ui-sans-serif,system-ui,Segoe UI,sans-serif;min-height:100vh}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.12;background-image:linear-gradient(#294154 1px,transparent 1px),linear-gradient(90deg,#294154 1px,transparent 1px);background-size:36px 36px;mask-image:linear-gradient(to bottom,black,transparent 85%)}
main{width:min(1040px,92vw);margin:auto;padding:34px 0 54px}
.top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:15px}
.brand{font-weight:900;letter-spacing:.22em;font-size:13px}
.brand b{color:var(--cyan)}
.status{font-size:11px;color:var(--muted);letter-spacing:.15em}
.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--amber);margin-right:8px;box-shadow:0 0 12px currentColor}
.hero{padding:58px 0 30px;text-align:center}
.eyebrow{color:var(--cyan);letter-spacing:.28em;font-size:11px;font-weight:800}
.hero h1{font-size:clamp(42px,9vw,88px);line-height:.92;margin:18px 0;letter-spacing:-.07em;font-weight:950}
.hero h1 span{color:var(--cyan);text-shadow:0 0 30px #63f3e455}
.sub{color:#a9bac9;max-width:600px;margin:auto;line-height:1.7;font-size:15px}
.panel{background:linear-gradient(145deg,#121e2b,#0b121c);border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 22px 70px #0006}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:14px;max-width:620px;margin:28px auto 0}
.action{border:1px solid #2c4559;background:#101b27;border-radius:13px;padding:20px;text-align:left;cursor:pointer;color:var(--white);transition:.2s}
.action:hover{border-color:var(--cyan);transform:translateY(-2px);box-shadow:0 10px 35px #63f3e414}
.action strong{display:block;font-size:16px;margin-bottom:6px}
.action small{color:var(--muted);line-height:1.5}
.action .symbol{font-size:24px;color:var(--cyan);margin-bottom:12px}
input{width:100%;background:#080f17;border:1px solid #2b4053;border-radius:10px;padding:14px;color:white;font-size:18px;letter-spacing:.15em;outline:none}
input:focus{border-color:var(--cyan)}
button{font:inherit}
.primary,.secondary{border:0;border-radius:10px;padding:13px 18px;font-weight:800;cursor:pointer}
.primary{background:var(--cyan);color:#061012}
.primary:hover{filter:brightness(1.08)}
.secondary{background:#1b2a39;border:1px solid #334b60;color:var(--white)}
.danger{color:var(--red)}
.hidden{display:none!important}
.center{text-align:center}
.formrow{display:flex;gap:10px;margin-top:12px}
.formrow>*{flex:1}
.tiny{font-size:11px;color:var(--muted);line-height:1.6}
.roomcode{font-size:32px;font-weight:900;letter-spacing:.2em;color:var(--cyan);margin:10px 0}
.sectionhead{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}
.tag{font-size:10px;letter-spacing:.18em;color:var(--cyan);border:1px solid #2e6968;padding:6px 9px;border-radius:99px}
.gamegrid{display:grid;grid-template-columns:1.1fr .9fr;gap:16px}
.metric{font-size:12px;color:var(--muted);letter-spacing:.13em}
.timer{font-size:30px;font-weight:900;color:var(--amber);font-variant-numeric:tabular-nums}
.signal{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:22px 0}
.pulse{width:54px;height:54px;border:1px solid #335064;border-radius:13px;display:grid;place-items:center;font-size:25px;background:#0a141e;box-shadow:inset 0 0 20px #63f3e40b}
.decoder{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}
.key{padding:11px;border:1px solid #2c4052;border-radius:9px;background:#0b141e;text-align:center;color:#c3d4e2;font-size:13px}
.key b{color:var(--cyan);font-size:18px;display:block;margin-bottom:3px}
.digits{display:flex;gap:7px;justify-content:center;margin:18px 0}
.digit{width:45px;height:48px;border:1px solid #345064;border-radius:9px;display:grid;place-items:center;font-size:23px;font-weight:800;background:#08111a}
.digit.filled{border-color:var(--cyan);color:var(--cyan)}
.pad{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;max-width:280px;margin:auto}
.pad button{padding:12px;border:1px solid #2a4052;border-radius:9px;background:#132130;color:white;font-size:18px;cursor:pointer}
.pad button:hover{border-color:var(--cyan);color:var(--cyan)}
.pad .clear{color:var(--red)}
.feed{min-height:52px;color:#a7bdce;font-size:13px;line-height:1.55}
.rounddots{display:flex;gap:7px}
.rounddots i{width:7px;height:7px;background:#31485a;border-radius:50%}
.rounddots i.on{background:var(--cyan);box-shadow:0 0 10px var(--cyan)}
.footer{margin-top:24px;text-align:center;color:#607487;font-size:10px;letter-spacing:.12em}
@media(max-width:700px){
main{padding-top:20px}
.hero{padding:42px 0 22px}
.actions{grid-template-columns:1fr}
.gamegrid{grid-template-columns:1fr}
.panel{padding:18px}
.top{align-items:flex-start}
.status{text-align:right}
.formrow{flex-direction:column}
.pulse{width:46px;height:46px}
}
</style>
</head>
<body>
<main>
<header class="top">
<div class="brand">◉ <b>DEAD AIR</b> / FIELD SYSTEMS</div>
<div class="status"><span class="dot"></span><span id="netStatus">AWAITING CONNECTION</span></div>
</header>
<section id="home">
<div class="hero">
<div class="eyebrow">A TWO-PERSON COOPERATIVE THRILLER</div>
<h1>TRUST THE<br><span>STATIC.</span></h1>
<p class="sub">One of you can see the signal. The other can read it. Neither of you can escape alone. You have 90 seconds before the station goes dark.</p>
</div>
<div class="actions">
<button class="action" id="hostBtn">
<div class="symbol">⌁</div>
<strong>CREATE A SIGNAL</strong>
<small>Open a private room and become the TRANSMITTER.</small>
</button>
<button class="action" id="joinBtn">
<div class="symbol">⌗</div>
<strong>JOIN A SIGNAL</strong>
<small>Enter a room code and become the DECODER.</small>
</button>
</div>
<div id="hostBox" class="panel hidden center" style="max-width:520px;margin:18px auto">
<div class="eyebrow">YOUR ROOM CODE</div>
<div class="roomcode" id="roomCode">------</div>
<p class="tiny">Send this code to your partner. Keep this page open while they connect.</p>
<div class="feed" id="hostFeed">Establishing secure channel…</div>
</div>
<div id="joinBox" class="panel hidden" style="max-width:520px;margin:18px auto">
<div class="eyebrow">ENTER TRANSMISSION CODE</div>
<div class="formrow">
<input id="codeInput" maxlength="6" placeholder="6-CHAR CODE" autocomplete="off">
<button class="primary" id="connectBtn">CONNECT</button>
</div>
<p class="tiny" id="joinFeed">Codes are six characters. Ask the transmitter for their room code.</p>
</div>
</section>
<section id="lobby" class="hidden">
<div class="hero">
<div class="eyebrow">CHANNEL ESTABLISHED</div>
<h1>NO ONE<br><span>GOES ALONE.</span></h1>
<p class="sub">Two roles. Two partial truths. Talk to each other. Your mission begins when both operators are ready.</p>
</div>
<div class="panel center">
<div class="sectionhead">
<span class="tag">OPERATORS ONLINE</span>
<span class="tiny" id="lobbyCode"></span>
</div>
<div class="gamegrid">
<div>
<div class="eyebrow">OPERATOR 01</div>
<h2>TRANSMITTER</h2>
<p class="tiny">You receive the raw symbol sequence. Describe it clearly. Do not enter the code.</p>
</div>
<div>
<div class="eyebrow">OPERATOR 02</div>
<h2>DECODER</h2>
<p class="tiny">You receive the secret symbol-to-number key. Listen carefully and enter the decoded sequence.</p>
</div>
</div>
<p class="feed" id="lobbyFeed">Waiting for both operators…</p>
<button class="primary" id="startBtn">BEGIN OPERATION</button>
</div>
</section>
<section id="game" class="hidden">
<div class="sectionhead">
<div>
<div class="eyebrow">LIVE OPERATION</div>
<h2 style="margin:7px 0 0">THE BLACK CHANNEL</h2>
</div>
<div class="center">
<div class="metric">TIME REMAINING</div>
<div class="timer" id="timer">01:30</div>
</div>
</div>
<div class="sectionhead">
<div class="rounddots" id="roundDots"><i class="on"></i><i></i><i></i></div>
<span class="tag" id="roleTag">TRANSMITTER</span>
</div>
<div class="gamegrid">
<div class="panel">
<div class="eyebrow" id="leftEyebrow">YOUR EYES ONLY</div>
<h2 id="leftTitle">RAW SIGNAL</h2>
<p class="tiny" id="leftDesc">Describe these symbols to your partner in order.</p>
<div class="signal" id="signal"></div>
<div class="feed" id="leftFeed">The signal is live. Speak clearly.</div>
</div>
<div class="panel">
<div class="eyebrow" id="rightEyebrow">YOUR EYES ONLY</div>
<h2 id="rightTitle">DECODER KEY</h2>
<p class="tiny" id="rightDesc">Use this key to translate your partner's symbols.</p>
<div class="decoder" id="decoder"></div>
<div class="digits" id="digits"></div>
<div class="pad" id="pad"></div>
<div class="feed" id="gameFeed">Waiting for decoded sequence…</div>
</div>
</div>
<div class="footer">NO CHAT. NO SHARED SCREEN. ONLY YOUR VOICES.</div>
</section>
<section id="end" class="hidden">
<div class="hero">
<div class="eyebrow">TRANSMISSION COMPLETE</div>
<h1 id="endTitle">SIGNAL<br><span>RESTORED.</span></h1>
<p class="sub" id="endText"></p>
</div>
<div class="panel center">
<div class="metric">FINAL PERFORMANCE</div>
<h2 id="scoreText"></h2>
<button class="primary" id="againBtn">RUN IT AGAIN</button>
<button class="secondary" id="homeBtn" style="margin-left:8px">MAIN MENU</button>
</div>
</section>
<div class="footer">DEAD AIR // A GAME ABOUT LISTENING, TRUST, AND WHAT GETS LOST IN TRANSMISSION</div>
</main>
<script>
const $=id=>document.getElementById(id);
const symbols=['◆','●','▲','✚','⬟','✦'];
let peer=null,conn=null,isHost=false,room='',role='',round=0,sequence=[],key={},entry='',timeLeft=90,tick=null,score=0,roundStart=0,gameActive=false;
const alphabet='ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
function show(id){
['home','lobby','game','end'].forEach(x=>$(x).classList.toggle('hidden',x!==id));
}
function status(s){$('netStatus').textContent=s;}
function say(id,s){$(id).textContent=s;}
function randomCode(){
let s='';
for(let i=0;i<6;i++)s+=alphabet[Math.floor(Math.random()*alphabet.length)];
return s;
}
function send(type,data={}){
if(conn&&conn.open)conn.send({type,...data});
}
function attach(c){
conn=c;
c.on('open',()=>{
status('CHANNEL CONNECTED');
say('hostFeed','Partner connected. Both operators are online.');
say('lobbyFeed','Both operators connected. Transmitter: start when ready.');
say('joinFeed','Connected. Waiting for operation to begin…');
show('lobby');
$('lobbyCode').textContent='ROOM '+room;
});
c.on('data',m=>{
if(!m||!m.type)return;
if(m.type==='start'&&!isHost){
round=m.round;
timeLeft=m.time;
startRound(m.data);
}
if(m.type==='submit'&&isHost){
const expected=sequence.map(s=>key[s]).join('');
if(m.entry===expected){
score+=Math.max(100,500-Math.floor((90-timeLeft)*4));
if(round<3){
round++;
setTimeout(()=>startRoundHost(),1000);
}else finish(true);
}else{
say('leftFeed','Incorrect decode. Recheck the sequence and try again.');
send('feedback',{text:'Not quite. Listen again and retry.'});
}
}
if(m.type==='feedback')say('gameFeed',m.text);
if(m.type==='finish')finish(m.win,m.score);
if(m.type==='restart'&&!isHost){
round=0;
score=0;
show('lobby');
}
});
c.on('close',()=>{
status('PARTNER DISCONNECTED');
say('gameFeed','Partner connection lost. Refresh and reconnect to try again.');
});
c.on('error',e=>{say('gameFeed','Connection error: '+e);});
}
function makePeer(id){
return new Promise((resolve,reject)=>{
peer=new Peer(id);
peer.on('open',resolve);
peer.on('error',reject);
peer.on('connection',c=>{
if(!isHost)return;
attach(c);
});
});
}
$('hostBtn').onclick=async()=>{
isHost=true;
role='TRANSMITTER';
room=randomCode();
$('hostBox').classList.remove('hidden');
$('joinBox').classList.add('hidden');
$('roomCode').textContent=room;
status('OPENING CHANNEL');
try{
await makePeer('deadair-'+room.toLowerCase());
say('hostFeed','Room is live. Share the six-character code with your partner.');
}catch(e){
say('hostFeed','Could not open the network channel. Check your connection and reload.');
status('CONNECTION FAILED');
}
};
$('joinBtn').onclick=()=>{
$('joinBox').classList.remove('hidden');
$('hostBox').classList.add('hidden');
$('codeInput').focus();
};
$('connectBtn').onclick=async()=>{
room=$('codeInput').value.toUpperCase().replace(/[^A-Z0-9]/g,'');
if(room.length!==6){
say('joinFeed','Enter all six characters.');
return;
}
isHost=false;
role='DECODER';
status('CONNECTING');
$('connectBtn').disabled=true;
try{
await makePeer();
conn=peer.connect('deadair-'+room.toLowerCase(),{reliable:true});
attach(conn);
setTimeout(()=>{
if(!conn.open)say('joinFeed','No room found yet. Check the code and try again.');
},8000);
}catch(e){
say('joinFeed','Could not connect. Check the code and internet connection.');
}finally{
$('connectBtn').disabled=false;
}
};
function makeRound(){
sequence=Array.from({length:5},()=>symbols[Math.floor(Math.random()*symbols.length)]);
let nums=[1,2,3,4,5,6];
for(let i=nums.length-1;i>0;i--){
let j=Math.floor(Math.random()*(i+1));
[nums[i],nums[j]]=[nums[j],nums[i]];
}
key={};
symbols.forEach((s,i)=>key[s]=nums[i]);
return {sequence,key};
}
function startRoundHost(){
if(round===0)round=1;
const data=makeRound();
timeLeft=90;
entry='';
gameActive=true;
roundStart=Date.now();
send('start',{round,time:90,data:{sequence:data.sequence,key:data.key}});
startRound(data);
}
function startRound(data){
sequence=data.sequence||null;
key=data.key;
timeLeft=90;
entry='';
gameActive=true;
show('game');
$('roundDots').innerHTML=[1,2,3].map(n=>`<i class="${n<=round?'on':''}"></i>`).join('');
$('roleTag').textContent=role;
$('timer').textContent='01:30';
$('signal').innerHTML='';
$('decoder').innerHTML='';
$('digits').innerHTML='';
$('pad').innerHTML='';
if(role==='TRANSMITTER'){
$('leftTitle').textContent='RAW SIGNAL';
$('leftDesc').textContent='Describe these five symbols to your partner, in exact order.';
$('signal').innerHTML=sequence.map(s=>`<div class="pulse">${s}</div>`).join('');
$('decoder').innerHTML='<div class="key" style="grid-column:1/-1">Your partner has the decoder key. Communicate the symbols only.</div>';
$('rightTitle').textContent='PARTNER CONSOLE';
$('rightDesc').textContent='Your partner is translating your signal.';
}else{
$('leftTitle').textContent='DECODER KEY';
$('leftDesc').textContent='Your partner sees symbols. Use this mapping to translate what they say.';
$('decoder').innerHTML=symbols.map(s=>`<div class="key"><b>${s}</b> = ${key[s]}</div>`).join('');
$('signal').innerHTML='<div class="key" style="width:100%">Listen to the transmitter. The five symbols are not shown here.</div>';
$('rightTitle').textContent='ENTER THE CODE';
$('rightDesc').textContent='Tap the digits in the order your partner describes.';
renderPad();
}
say('gameFeed',role==='DECODER'?'Listen to your partner and enter five digits.':'Describe the sequence. Your partner has the key.');
if(tick)clearInterval(tick);
tick=setInterval(()=>{
if(!gameActive)return;
timeLeft--;
if(isHost)send('clock',{time:timeLeft});
$('timer').textContent='00:'+String(Math.max(0,timeLeft)).padStart(2,'0');
if(timeLeft<=0){
clearInterval(tick);
if(isHost)finish(false);
else say('gameFeed','Time expired. The station has gone dark.');
}
},1000);
}
function renderPad(){
$('digits').innerHTML=Array.from({length:5},(_,i)=>`<div class="digit ${entry[i]?'filled':''}">${entry[i]||'_'}</div>`).join('');
$('pad').innerHTML=[1,2,3,4,5,6,7,8,9,'clear',0,'send'].map(v=>`<button data-v="${v}" class="${v==='clear'?'clear':''}">${v==='send'?'↵':v==='clear'?'⌫':v}</button>`).join('');
$('pad').querySelectorAll('button').forEach(b=>b.onclick=()=>{
let v=b.dataset.v;
if(v==='clear')entry=entry.slice(0,-1);
else if(v==='send'){submitEntry();return;}
else if(entry.length<5)entry+=v;
renderPad();
});
}
function submitEntry(){
if(entry.length!==5){
say('gameFeed','Enter all five digits first.');
return;
}
if(isHost){
const correct=sequence.map(s=>key[s]).join('')===entry;
if(correct){
score+=Math.max(100,500-Math.floor((90-timeLeft)*4));
if(round<3){
round++;
setTimeout(startRoundHost,900);
}else finish(true);
}else say('gameFeed','Incorrect. Try again.');
}else{
send('submit',{entry});
say('gameFeed','Code transmitted. Waiting for station response…');
}
}
function finish(win,remoteScore){
gameActive=false;
if(tick)clearInterval(tick);
if(isHost)send('finish',{win,score});
show('end');
$('endTitle').innerHTML=win?'SIGNAL<br><span>RESTORED.</span>':'CHANNEL<br><span>LOST.</span>';
$('endText').textContent=win?'You combined two partial truths into one clear signal. The station is safe — because you listened.':'The countdown reached zero. The signal was lost. Reset, communicate, and try again.';
$('scoreText').textContent=win?(isHost?score:'MISSION COMPLETE')+' POINTS / 3 ROUNDS':'0 / 3 ROUNDS';
}
$('startBtn').onclick=()=>{
if(!isHost){
say('lobbyFeed','The transmitter starts the operation.');
return;
}
round=1;
score=0;
startRoundHost();
};
$('againBtn').onclick=()=>{
if(isHost){
round=0;
score=0;
send('restart');
show('lobby');
}else say('endText','Ask the transmitter to start another operation.');
};
$('homeBtn').onclick=()=>location.reload();
</script>
</body>
</html>